# Backend environment. Copy to .env at the repository root: Django
# reads it, and docker compose reads it too. The POSTGRES_* values MUST
# match in both places: compose creates the database with them, Django
# connects with them.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB={{POSTGRES_DB}}
POSTGRES_USER={{POSTGRES_USER}}
POSTGRES_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:{{FRONTEND_PORT}}
# Lets the browser send the httpOnly refresh cookie cross-origin
# (Vite :{{FRONTEND_PORT}} -> API :{{BACKEND_PORT}}). Keep 1 unless the frontend is same-origin:
CORS_ALLOW_CREDENTIALS=1
# Set 1 in production (HTTPS) so the refresh cookie is only sent over
# TLS. Must stay 0 on plain http://localhost, or the browser will not
# send the cookie at all:
REFRESH_COOKIE_SECURE=0
# Local tests only, without PostgreSQL (unset = PostgreSQL):
# DATABASE_ENGINE=sqlite
