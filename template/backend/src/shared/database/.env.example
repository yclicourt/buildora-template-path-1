# SEGUNDO .env: este archivo lo lee Prisma (migrate/generate), NO la app.
# La app NestJS lee backend/.env; Prisma lee ESTE archivo porque
# prisma7.config.ts vive en este mismo directorio (src/shared/database/).
# Los dos deben tener la MISMA DATABASE_URL.
# Copia este archivo a .env en este mismo directorio:
#   cp src/shared/database/.env.example src/shared/database/.env
DATABASE_URL=postgresql://{{POSTGRES_USER}}:cambia-esta-clave@localhost:5432/{{POSTGRES_DB}}
