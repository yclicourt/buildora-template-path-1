# Puerto del backend NestJS.
PORT={{BACKEND_PORT}}

# Postgres local (docker-compose.yml).
# Debe coincidir con POSTGRES_USER, POSTGRES_PASSWORD y POSTGRES_DB del compose.
# Si cambias POSTGRES_PASSWORD aquí, cambia también DATABASE_URL abajo.
DATABASE_URL=postgresql://{{POSTGRES_USER}}:cambia-esta-clave@localhost:5432/{{POSTGRES_DB}}

# Variables que lee docker compose (el compose corre desde backend/,
# así que lee este mismo .env automáticamente).
POSTGRES_USER={{POSTGRES_USER}}
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB={{POSTGRES_DB}}
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# Redis local (docker-compose.yml).
REDIS_URL=redis://localhost:6379

# JWT: los dos secretos son obligatorios (el servicio los exige con getOrThrow).
# Cambiar en cada entorno; nunca commitear valores reales aquí.
JWT_ACCESS_SECRET=cambia-este-secreto
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-este-secreto
JWT_REFRESH_EXPIRES_IN=7d

# Orígenes CORS del frontend (opcionales).
ORIGIN_CLIENT_DEVELOPMENT=http://localhost:{{FRONTEND_PORT}}
ORIGIN_CLIENT_PRODUCTION=
